pipeline {
    agent any

    stages {
        stage('BUILD') {
            agent { label 'master' }
            steps {
                sh '''
                    pwd
                    sleep 5
                    echo This is the first stage: BUILD
                '''
            }
        }

        stage('TEST') {
            agent { label 'master' }
            steps {
                sh '''
                    pwd
                    sleep 5
                    echo This is the first stage: TEST
                '''
            }
        }
    }
}
